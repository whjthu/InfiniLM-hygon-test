  summaries.append(dict(shard=j,actual_GPU=w['actual_GPU'],CPU_keeper=w['CPU_keeper'],actual_client=w['actual_client'],HTTP=c['completed_HTTP'],passed=w['passed']))
 original=shards[3];label=original['label']+'-'+original['run'];labels.append(label);w=json.loads((R/'results'/(label+'-watch.json')).read_bytes());path=R/'results/Deep-broad-fewshot-fullpre-quality-r450'/original['run']
 ledger.append(dict(shard=3,attempt='j3a-original-failed-bootstrap',source_namespace='deployment',run=original['run'],label=original['label'],CPU_keeper='910407.951',actual_GPU=w.get('actual_GPU'),actual_client=w.get('actual_client'),completed=w['completed'],passed=w['passed'],runtime_directory_exists=path.exists(),observed_completed_HTTP=0,unexecuted_logical_HTTP=64,cleanup_post='910374.1402',not_retroactive_normal=True))
