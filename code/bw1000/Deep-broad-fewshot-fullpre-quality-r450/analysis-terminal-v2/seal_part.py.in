 for row in c['rows']:
  stem='%04d'%row['logical_index'];add(key+stem+'.request.json',cp.parent/(stem+'.request.json'),row['request_body_SHA256']);add(key+stem+'.wire',cp.parent/(stem+'.wire'),row['wire_SHA256'])
 for alias,name in [('owner.json','owner.json'),('ready.json','MODEL_READY.json'),('frontend.json','FRONTEND.json'),('closed.json','closed-engine.json'),('STOP.json','STOP.json')]:
  if(runtime/name).is_file():add(key+alias,runtime/name)
 ip=cp.parent.with_name(cp.parent.name+'-identity.json')
 if ip.is_file():add(key+'client-identity.json',ip)
 ip=R/'results'/(label+'-intent.json')
 if ip.is_file():add(key+'intent.json',ip)
