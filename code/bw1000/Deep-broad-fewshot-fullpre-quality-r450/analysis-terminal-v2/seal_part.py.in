def add(n,p,expected=None):
 global total
 p=Path(p);assert n not in files and p.resolve().is_relative_to(R.resolve());raw=p.read_bytes();assert len(raw)<256*1024**2;total+=len(raw);assert total<512*1024**2;h=H(raw)
 if expected:assert h==expected,(n,h,expected)
 files[n]=dict(original_path=str(p),bytes=len(raw),SHA256=h,base64=base64.b64encode(raw).decode());return raw
