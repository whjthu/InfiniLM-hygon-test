@@ -527,7 +573,12 @@ def run_hunyuanvideo_data_parallel(weights: Path, config: dict[str, Any], output
             raise
     path = output_dir / "dp2-result.json"
     result = json.loads(path.read_text(encoding="utf-8"))
-    validate_dp_result(result, resumed=config.get("resume_from_checkpoint") is not None)
+    resumed = config.get("resume_from_checkpoint") is not None
