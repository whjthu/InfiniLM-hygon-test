-                   "timing_boundary": "before first measured update through completed final two-rank checkpoint commit and barrier; includes replicated-state checks and checkpoint IO; excludes loading and warmup", "completed_global_step_at_start": completed,
+                   "timing_boundary": TIMING_BOUNDARY, "completed_global_step_at_start": completed,
