+def validate_deployment_paths(config):
+    """Reject host-generated Windows/relative deployment paths before devices.
+
+    Do not normalize the provider dictionary at runtime: the original exact
+    comparison with actual /proc/maps paths and hashes remains authoritative.
+    """
+    paths = {key: config[key] for key in ['model_path', 'processor_path',
+        'Native_library', 'Common_extension', 'Common_python_root', 'runtime_directory']}
+    paths.update({'FP8_helpers_SHA256 key ' + str(key): key
+                  for key in config['FP8_helpers_SHA256']})
+    for field, value in paths.items():
+        if type(value) is not str or '\\' in value or not PurePosixPath(value).is_absolute():
+            raise ValueError('Deployment path must be POSIX absolute: ' + field)
+    return config
 
 
