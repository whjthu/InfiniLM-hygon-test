          "text": "        copy_from(destination, std::move(src));"
        },
        {
          "line": 144,
          "text": "    } else if (device().type() == Device::Type::kCpu) {"
        },
        {
          "line": 145,
          "text": "        copy_from(source, std::move(src));"
        },
        {
          "line": 146,
          "text": "    } else if (&source == &destination) {"
        },
        {
          "line": 147,
          "text": "        copy_from(destination, std::move(src));"
        },
        {
          "line": 148,
          "text": "    } else {"
        },
        {
          "line": 149,
          "text": "        if (source.graphCaptureState() != ::infinilm::execution::graph::GraphManager::CaptureState::kInactive"
