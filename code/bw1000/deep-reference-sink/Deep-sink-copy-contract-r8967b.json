        {
          "line": 129,
          "text": "void TensorImpl::copy_from(Runtime &destination, Runtime &source, Tensor src) {"
        },
        {
          "line": 130,
          "text": "    destination.assertOwnerThread();"
        },
        {
          "line": 131,
          "text": "    source.assertOwnerThread();"
        },
        {
          "line": 132,
          "text": "    if (!src) {"
