        {
          "line": 151,
          "text": "            throw std::logic_error(\"cross-owner copies are not allowed during graph recording\");"
        },
        {
          "line": 152,
          "text": "        }"
        },
        {
          "line": 153,
          "text": "        if (source.device() == destination.device()) {"
