@@ -169,6 +169,27 @@ def _import_model(config: dict[str, Any]) -> tuple[Any, Any]:
     return module.SLatFlowModel, sp
 
 
+def realize_flow_inputs(clean: Any, fraction: Any, noise: Any) -> tuple[Any, Any]:
+    sigma_min = 1e-5
+    coefficient = (sigma_min + (1.0 - sigma_min) * fraction).to(clean.dtype)
+    noised = (1.0 - fraction.to(clean.dtype)) * clean + coefficient * noise
+    target = (1.0 - sigma_min) * noise - clean
+    return noised, target
+
+
+def flow_prediction_and_loss(
+    torch: Any, model: Any, sparse: Any, coords: Any, noised: Any, fraction: Any, condition: Any, target: Any,
+) -> tuple[Any, Any]:
+    sample = sparse.SparseTensor(feats=noised, coords=coords)
+    with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
+        prediction = model(sample, fraction * 1000.0, condition)
+        require(torch.equal(prediction.coords, coords), "prediction coordinates or order changed")
+        require(prediction.feats.shape == noised.shape and prediction.feats.device == noised.device
+                and prediction.feats.dtype == torch.bfloat16, "prediction shape/device/precision differs")
+        loss = (prediction.feats.float() - target.float()).square().mean()
+    return prediction, loss
+
+
