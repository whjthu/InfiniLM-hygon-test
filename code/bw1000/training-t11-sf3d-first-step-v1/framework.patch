@@ -94,6 +94,20 @@ def _selected_named_parameters(model: Any) -> list[tuple[str, Any]]:
     ]
 
 
+def _prepare_material_heads(model: Any) -> list[tuple[str, Any]]:
+    for parameter in model.parameters():
+        parameter.requires_grad_(False)
+    for module in (
+        model.decoder.heads["features"],
+        model.image_estimator.heads["roughness"],
+        model.image_estimator.heads["metallic"],
+    ):
+        module.train()
+        for parameter in module.parameters():
+            parameter.requires_grad_(True)
+    return _selected_named_parameters(model)
+
+
 def _parameter_sha(named_parameters: list[tuple[str, Any]]) -> str:
     digest = hashlib.sha256()
     for name, parameter in named_parameters:
@@ -125,6 +139,31 @@ def _beta_mean(torch: Any, head: Any, image_features: Any) -> Any:
     return alpha / (alpha + beta)
 
 
+def _material_forward_loss(
+    torch: Any, model: Any, batch: dict[str, Any], scalar_loss_weight: float
+) -> tuple[Any, Any, Any, Any, Any, Any]:
+    albedo = torch.sigmoid(
+        model.decoder.heads["features"](batch["triplane_features"])
+    )
+    roughness = _beta_mean(
+        torch,
+        model.image_estimator.heads["roughness"],
+        batch["image_features"],
+    )
+    metallic = _beta_mean(
+        torch,
+        model.image_estimator.heads["metallic"],
+        batch["image_features"],
+    )
+    albedo_loss = (albedo.float() - batch["albedo"]).square().mean()
+    scalar_loss = (
+        (roughness.float() - batch["roughness"]).square().mean()
+        + (metallic.float() - batch["metallic"]).square().mean()
+    )
+    loss = albedo_loss + scalar_loss_weight * scalar_loss
+    return albedo, roughness, metallic, loss, albedo_loss, scalar_loss
+
+
 def _image_features(torch: Any, model: Any, batch: dict[str, Any]) -> Any:
     import open_clip
 
