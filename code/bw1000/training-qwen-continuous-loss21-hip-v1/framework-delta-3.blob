import json
from pathlib import Path
from tempfile import TemporaryDirectory
import unittest

from vlm.runtime.qwen_loss_boundary_trace import LossBoundaryTrace, MODULES, compare_loss_boundaries
from vlm.tests.test_qwen_layer_trace import Hidden, Layer, snapshot


class QwenLossBoundaryTest(unittest.TestCase):
    def test_localizes_gradient_change_across_native_head(self):
        with TemporaryDirectory() as tmp:
            modules = {name: Layer() for name in MODULES}
            path = Path(tmp) / 'loss-21.json'
            trace = LossBoundaryTrace(modules, path, 1, snapshot)
            trace.forward_entry(1)
            tensors = [Hidden(str(i)) for i in range(4)]
            for layer, a, b in zip(modules.values(), tensors, tensors[1:]):
                layer.before(layer, (a,), {})
                layer.after(layer, (a,), {}, b)
            trace.forward_returned(1)
            decoder = modules['last_decoder']
            decoder.before(decoder, (tensors[0],), {})
            for value in reversed(tensors):
                for hook in value.hooks:
                    self.assertIsNone(hook(Hidden('gradient')))
            trace.backward_returned(1)
            trace.finish()
            left = json.loads(path.read_bytes())
            right = json.loads(path.read_bytes())
            right['boundaries']['lm_head']['grad_input']['SHA256'] = 'changed'
            pair = compare_loss_boundaries(left, right)
            self.assertTrue(pair['lm_head']['grad_output']['logical_sha_equal'])
            self.assertFalse(pair['lm_head']['grad_input']['logical_sha_equal'])

    def test_requires_the_logit_gradient(self):
        row = dict(complete=True, ordinal=1,
                   boundaries={name: {} for name in MODULES})
        with self.assertRaisesRegex(ValueError, 'inventory differs'):
            compare_loss_boundaries(row, row)
